{
  "name": "@mcowger/solar",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "bin": {
    "solar": "./bin/solar.js"
  },
  "engines": {
    "bun": ">=1.4.3"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "solar": "bun run scripts/solar.ts",
    "init-worktree": "bun run scripts/init-worktree.ts",
    "dev": "bun run scripts/solar.ts dev start",
    "dev:get:frp-url": "bun run scripts/dev-config.ts frp_url",
    "build": "bun run --cwd apps/web build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "prepare": "command -v lefthook >/dev/null 2>&1 && lefthook install || true",
    "package": "bun run build && bun build apps/server/src/index.ts --outdir dist --target bun --minify --sourcemap --define 'process.env.NODE_ENV=\"production\"' --external @struktoai/mirage-node && bun build apps/server/src/db/migrations/*.ts --root apps/server/src/db/migrations --outdir dist/migrations --target bun && cp apps/server/src/pi/bridge/extension.ts dist/pi-extension.ts && rm -rf dist/web && mkdir -p dist/web && cp -R apps/server/dist/web/. dist/web",
    "migrate": "bun run --cwd apps/server migrate",
    "migrate:auth": "bun run --cwd apps/server migrate:auth",
    "codegen": " bun run --cwd apps/server codegen",
    "typecheck": "(bun check -p apps/server/tsconfig.json && bun check -p apps/web/tsconfig.json && bun check -p packages/shared/tsconfig.json && bun check -p tsconfig.e2e.json)",
    "test": "bun run --parallel test:server test:web",
    "test:server": "bun test --parallel apps/server/src",
    "test:web": "bun run --cwd apps/web test",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test --project=chromium",
    "test:e2e:all": "node ./node_modules/@playwright/test/cli.js test",
    "test:e2e:install": "node ./node_modules/@playwright/test/cli.js install chromium firefox webkit",
    "deploy:staging": "bun run scripts/deploy.ts staging",
    "deploy:production": "bun run scripts/deploy.ts production"
  },
  "dependencies": {
    "@struktoai/mirage-node": "^0.0.3",
    "kysely": "^0.27.4",
    "kysely-bun-sqlite": "^0.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@playwright/test": "^1.61.1",
    "agent-browser": "^0.32.2",
    "bun-types": "^1.4.0",
    "lefthook": "^2.1.10"
  }
}
